{
  "name": "GitOps Dev Container",

  "image": "debian:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "userUid": "1000",
      "userGid": "1000"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2.14.0": {}
  },
  "postCreateCommand": "./.devcontainer/post-create.sh",

  "remoteUser": "vscode",

  "forwardPorts": [8080, 8443, 3000],

  "postCreateCommand": "./.devcontainer/post-create.sh",

  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.devbox/nix/profile/default/bin:${containerEnv:PATH}"
  },

  "customizations": {
    "codespaces": {

      "repositories": {
        "DAWS25/GitOps-Secrets": {
          "permissions": {
            "contents": "read"
          }
        }
      },

      "vscode": {
        "settings": {},
        "extensions": [
          "ms-azuretools.vscode-docker",

          "github.copilot",
          "github.copilot-chat",

          "vscjava.vscode-java-pack",
          "vscjava.vscode-java-debug",
          "vscjava.vscode-java-dependency",
          "vscjava.vscode-java-test",
          "vscjava.vscode-maven",
          "redhat.java",

          "Tobermory.es6-string-html",
          "vue.volar",

          "jetpack-io.devbox"
        ]
      }
    }
  }
}